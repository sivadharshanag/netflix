# Copy this file to .env.local (git-ignored) and fill in real values.
# .env.local is loaded first and wins over .env. Put SECRETS (storage keys)
# only in .env.local or in the Render dashboard — never in a committed file.

NODE_ENV=development
PORT=3000

# A long, random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# The Argon2id hash of the birthday passcode — NOT the plaintext password.
# Generate it with: npm run hash-password -- "yourSecretPasscode"
BIRTHDAY_PASSWORD_HASH=replace-with-a-real-password-hash

# Set to "true" only when serving over HTTPS in production, so session
# cookies get the Secure flag.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Media storage
#   local -> read photos/videos from MEDIA_ROOT on this machine (default)
#   s3    -> read from an S3-compatible bucket (Cloudflare R2, Backblaze B2)
# ---------------------------------------------------------------------------
MEDIA_STORAGE=local

# Folder that contains the real photo/video collection. Used in local mode,
# and as the source folder for `npm run upload-media`.
MEDIA_ROOT=./media

# --- Only needed when MEDIA_STORAGE=s3, or to run `npm run upload-media` ---
# Cloudflare R2:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com   region: auto
# Backblaze B2:   https://s3.<region>.backblazeb2.com             region: e.g. us-west-004
S3_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
S3_BUCKET=varunika-media
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# How long each presigned media link stays valid, in seconds (default 6h).
S3_SIGNED_URL_TTL=21600
